<Window x:Class="CcGlance.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CcGlance"
        Title="ccglance"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="False"
        Width="300"
        Height="100"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <!-- Grayscale: ClearType fringes on a translucent surface -->
    <Border x:Name="Root" CornerRadius="12" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <StackPanel Orientation="Vertical">
                <local:CrabView x:Name="Crab" HorizontalAlignment="Center" Margin="0,30,0,30" />
                <StackPanel x:Name="Rows" Margin="6,0,6,0" />
                <TextBlock x:Name="EmptyLabel"
                           Text="No active sessions"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock x:Name="UpdateBanner"
                       FontSize="10"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,6"
                       Cursor="Hand"
                       Visibility="Collapsed" />
            <!-- Width-only resize, like the macOS edge strips -->
            <Border x:Name="LeftGrip" Width="8" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE" />
            <Border x:Name="RightGrip" Width="8" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" />
        </Grid>
    </Border>
</Window>
